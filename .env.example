# Copy to .env.local and adjust. Anything VITE_-prefixed is compiled into the
# bundle and readable by anyone who opens devtools — put no secrets here.

# Where the backend lives. Same-origin "/api" by default.
VITE_API_URL=/api

# "http" (default) or "sample". Sample is the deterministic development data in
# src/lib/api/sample.ts; leaving this unset gives you the real backend, so a
# production build cannot ship made-up figures by accident.
VITE_DATA_SOURCE=sample

# NOT HERE: the Loyverse access token. It has no scopes at all — it grants full
# read and write over the entire merchant account — so it belongs only in the
# backend's secret store. See docs/LOYVERSE.md.
